{
    "compilerOptions": {
      "target": "es2019",
      "module": "es6",
      "moduleResolution": "node",
      "strict": true,
      "sourceMap": true,
      "outDir": "./dist",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "typeRoots": [
        "node_modules/@types",
        "src/types"
      ]
    },
    "include": [
      "src/**/*"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ]
}
